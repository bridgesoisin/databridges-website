# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# office temp / lock files
~$*
*.tmp

# private source material (CVs, business docs) — kept on disk, never committed
/Addtional Material/

# claude code / overnight runner
.claude/worktrees/
.claude/overnight-session-id
scripts/overnight.log
scripts/overnight-summary.md
esbuild.err

# visibility index scan reports (may contain third-party data; never commit)
/reports/
